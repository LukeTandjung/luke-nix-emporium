+(-> test-conversation-file-context-hardening () null)
+(defun test-conversation-file-context-hardening ()
+  "Test file-only reload and malformed persisted context rejection."
+  (let* ((configuration (test-configuration))
+         (root (test-configuration-root configuration))
+         (source (merge-pathnames "only.txt" root)))
+    (unwind-protect
+         (progn
+           (with-open-file (stream source :direction :output
+                                   :if-exists :supersede
+                                   :external-format :utf-8)
+             (write-string "file only" stream))
+           (let* ((context (workspace-file-context-snapshot root "only.txt"))
+                  (conversation
+                    (conversation-create configuration :identifier "file-only")))
+             (conversation-append-user-message
+              conversation
+              (user-message-input-create
+               :text "Review @only.txt" :file-contexts (list context)))
+             (let* ((loaded (conversation-load-by-id configuration "file-only"))
+                    (content (json-get (first (conversation-input-items loaded))
+                                       "content"))
+                    (provider-text (json-get (aref content 0) "text")))
+               (test-assert
+                (and (search "Review @only.txt" provider-text)
+                     (search "file only" provider-text))
+                "conversation reload restores file-only provider context"))
+             (test-assert
+              (handler-case
+                  (progn
+                    (conversation--project-record
+                     :message conversation
+                     '(:seq 9 :role :user :content "bad"
+                       :context-content 42))
+                    nil)
+                (conversation-invariant-error () t))
+              "replay rejects a non-string context-content field")))
+      (uiop:delete-directory-tree root :validate t
+                                  :if-does-not-exist :ignore)))
+  nil)
+
