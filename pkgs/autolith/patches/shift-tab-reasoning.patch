+(-> test-terminal-inline-file-hardening () null)
+(defun test-terminal-inline-file-hardening ()
+  "Test exact tokens, stable file candidates, history, and file safety."
+  (let* ((configuration (test-configuration))
+         (root (test-configuration-root configuration))
+         (a (merge-pathnames "a" root))
+         (ab (merge-pathnames "a.b" root))
+         (invalid (merge-pathnames "invalid.txt" root))
+         (large (merge-pathnames "large.txt" root))
+         (directory (merge-pathnames "directory/" root))
+         (link (merge-pathnames "link.txt" root))
+         (outside (merge-pathnames "../outside.txt" root)))
+    (labels ((write-text (path text)
+               (ensure-directories-exist path)
+               (with-open-file (stream path :direction :output
+                                       :if-exists :supersede
+                                       :external-format :utf-8)
+                 (write-string text stream)))
+             (rejected-p (path)
+               (handler-case
+                   (progn (workspace-file-context-snapshot root path) nil)
+                 (tool-error () t))))
+      (unwind-protect
+           (progn
+             (write-text a "a")
+             (write-text ab "ab")
+             (write-text large "large")
+             (write-text outside "outside")
+             (ensure-directories-exist directory)
+             (with-open-file (stream invalid :direction :output
+                                     :if-exists :supersede
+                                     :element-type '(unsigned-byte 8))
+               (write-byte #xff stream))
+             (ignore-errors (delete-file link))
+             (sb-posix:symlink (namestring a) (namestring link))
+             (let* ((context-a (workspace-file-context-snapshot root "a"))
+                    (context-ab (workspace-file-context-snapshot root "a.b"))
+                    (ui (terminal-ui-create
+                         :terminal (make-instance 'recording-terminal :columns 80))))
+               (setf (terminal-ui-file-contexts ui) (list context-a context-ab))
+               (terminal-ui--prune-file-contexts ui "@a.b")
+               (test-assert
+                (equal (mapcar #'workspace-file-context-path
+                               (terminal-ui-file-contexts ui))
+                       '("a.b"))
+                "file context pruning uses complete token boundaries"))
+             (test-assert (rejected-p "../outside.txt")
+                          "inline context rejects paths outside the workspace")
+             (test-assert (rejected-p "link.txt")
+                          "inline context rejects symbolic links")
+             (test-assert (rejected-p "directory/")
+                          "inline context rejects nonregular files")
+             (test-assert (rejected-p "invalid.txt")
+                          "inline context rejects invalid UTF-8")
+             (let ((*workspace-file-context-maximum-file-bytes* 2))
+               (test-assert (rejected-p "large.txt")
+                            "inline context enforces its per-file byte limit"))
+             (let ((ui nil)
+                   (queries nil)
+                   (provider-under-lock-p nil))
+               (setf ui
+                     (terminal-ui-create
+                      :terminal (make-instance 'recording-terminal :columns 80)
+                      :workspace-root root
+                      :file-completion-function
+                      (lambda (query)
+                        (push (copy-seq query) queries)
+                        (setf provider-under-lock-p
+                              (eq (sb-thread:mutex-owner (terminal-ui-lock ui))
+                                  sb-thread:*current-thread*))
+                        (cond
+                          ((string= query "missing") nil)
+                          ((string= query "error") (error "search failure"))
+                          (t (list (list :name "a" :value "a" :argument nil
+                                         :description "workspace file")))))))
+               (with-terminal-ui (active-ui ui)
+                 (terminal-ui-process-event active-ui '(:insert "use @a"))
+                 (let ((count (length queries)))
+                   (terminal-ui-process-event active-ui :complete-previous)
+                   (test-assert (= count (length queries))
+                                "file navigation does not refetch candidates")
+                   (terminal-ui-process-event active-ui :complete)
+                   (test-assert (= count (length queries))
+                                "file acceptance uses the painted candidate"))
+                 (multiple-value-bind (action submitted)
+                     (terminal-ui-process-event active-ui :submit)
+                   (declare (ignore action submitted)))
+                 (terminal-ui-process-event active-ui :history-previous)
+                 (multiple-value-bind (action recalled)
+                     (terminal-ui-process-event active-ui :submit)
+                   (test-assert
+                    (and (eq action :submit)
+                         (typep recalled 'user-message-input)
+                         (= (length (user-message-input-file-contexts recalled)) 1))
+                    "history recall restores selected file snapshots"))
+                 (terminal-ui-set-input active-ui "use @missing")
+                 (let ((text (line-editor-text (terminal-ui-editor active-ui))))
+                   (multiple-value-bind (action payload)
+                       (terminal-ui-process-event active-ui :complete)
+                     (declare (ignore payload))
+                     (test-assert
+                      (and (eq action :handled)
+                           (string= text
+                                    (line-editor-text (terminal-ui-editor active-ui))))
+                      "Tab does not submit an unmatched active file query")))
+                 (terminal-ui-set-input active-ui "use @error")
+                 (terminal-ui-process-event active-ui :complete)
+                 (test-assert
+                  (and (search "File search failed" (terminal-ui-notice active-ui))
+                       (not provider-under-lock-p))
+                  "file search runs outside the UI lock and reports errors"))))
+        (ignore-errors (delete-file link))
+        (ignore-errors (delete-file outside))
+        (uiop:delete-directory-tree root :validate t
+                                    :if-does-not-exist :ignore))))
+  nil)
