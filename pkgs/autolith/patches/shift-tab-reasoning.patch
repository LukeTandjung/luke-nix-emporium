+(-> application--next-reasoning-effort (application) (option string))
+(defun application--next-reasoning-effort (application)
+  "Return the next supported effort for APPLICATION's active model, wrapping."
+  (let* ((configuration (application-configuration application))
+         (efforts
+           (configuration--reasoning-efforts-for
+            (configuration-model configuration)))
+         (current (configuration-reasoning-effort configuration))
+         (tail (member current efforts :test #'string=)))
+    (or (second tail) (first efforts))))
