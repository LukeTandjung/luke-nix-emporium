+                                  entries)
+              (terminal-ui--repaint-live ui))))
+        (error (condition)
+               (with-terminal-ui-locked (ui)
+                 (when
+                     (terminal-ui--file-completion-current-p ui start end query
+                      generation)
+                   (setf (terminal-ui-notice ui)
