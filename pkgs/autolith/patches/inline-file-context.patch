+                    (eql end (terminal-ui-file-completion-end ui))
+                    (equal query (terminal-ui-file-completion-query ui)))
+               nil)
+              (t
+               (setf (terminal-ui-file-completion-start ui) start
+                     (terminal-ui-file-completion-end ui) end
