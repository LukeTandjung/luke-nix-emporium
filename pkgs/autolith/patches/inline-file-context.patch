+(defun test-native-file-snapshots ()
+  "Native selector, exact names, cancellation, directory insertion and bounds."
+  (let* ((root (test-configuration-root (test-configuration)))
+         (names '("plain" "space name" "bracket [git:clean].txt"
+                  "quote\"name" "back\\slash" "wild[*?].txt"))
+         (terminal (make-instance 'recording-terminal))
+         (ui (terminal-ui-create :terminal terminal :completion-root root))
+         (queries nil))
+    (unwind-protect
+         (progn
+           (dolist (name names)
+             (test-terminal-path-completion-write
+              (merge-pathnames (uiop:parse-native-namestring name) root) name))
+           (ensure-directories-exist (merge-pathnames "directory/" root))
+           (let ((entries (terminal-path-completion-entries root "@")))
+             (dolist (name names)
+               (test-assert (find name entries :key (lambda (e) (getf e :name))
+                                              :test #'string=)
+                            "native filesystem completion preserves exact names")))
+           (with-terminal-ui (active-ui ui)
+             (dolist (name names)
+               (setf (terminal-ui-path-search-function active-ui)
+                     (lambda (query) (push query queries) (list name)))
+               (terminal-ui-set-input active-ui "read @query suffix")
+               (line-editor-set-text (terminal-ui-editor active-ui)
+                                     "read @query suffix" :cursor 10)
+               (terminal-ui-process-event active-ui :complete)
+               (test-assert
+                (and (member "query" queries :test #'string=)
+                     (string= (line-editor-text (terminal-ui-editor active-ui))
+                              (format nil "read ~A suffix" name))
+                     (string= (workspace-file-context-content
+                               (first (terminal-ui-file-contexts active-ui))) name))
+                "native provider and selector splice exact path and snapshot")
+               (terminal-ui-process-event active-ui :escape)
+               (test-assert
+                (and (string= (line-editor-text (terminal-ui-editor active-ui))
+                              "read @query suffix")
+                     (null (terminal-ui-file-contexts active-ui)))
+                "Escape restores original text and attachment metadata")
+               (line-editor-set-text (terminal-ui-editor active-ui)
+                                     "read @query suffix" :cursor 10)
+               (terminal-ui-process-event active-ui :complete)
+               ;; The native selector previews with Tab, commits with Enter.
+               (test-terminal-path-completion-write
+                (merge-pathnames (uiop:parse-native-namestring name) root) "changed")
+               (terminal-ui-process-event active-ui :submit)
+               (multiple-value-bind (action payload)
+                   (terminal-ui-process-event active-ui :submit)
+                 (test-assert
+                  (and (eq action :submit)
+                       (string= (workspace-file-context-content
+                                 (first (user-message-input-file-contexts payload)))
+                                name))
+                  "submission preserves preview snapshot instead of rereading"))
+               (terminal-ui-process-event active-ui :history-previous)
+               (test-assert
+                (string= (workspace-file-context-content
+                          (first (terminal-ui-file-contexts active-ui))) name)
+                "native selected filenames recall their own snapshots"))
+             (setf (terminal-ui-path-search-function active-ui)
+                   (lambda (query) (declare (ignore query)) (list "plain" "space name")))
+             (terminal-ui-set-input active-ui "@")
+             (terminal-ui-process-event active-ui :complete)
+             (terminal-ui-process-event active-ui :complete)
+             (test-assert (= (length (terminal-ui-file-contexts active-ui)) 1)
+                          "cycling native candidates does not accumulate snapshots")
+             (multiple-value-bind (action payload)
+                 (terminal-ui-process-event active-ui :complete-previous)
+               (declare (ignore payload))
+               (test-assert (and (eq action :changed)
+                                 (= (length (terminal-ui-file-contexts active-ui)) 1))
+                            "native path completion takes Shift-Tab before reasoning"))
+             (terminal-ui-process-event active-ui :escape)
+             ;; Escape can dismiss merely offered candidates without a preview.
+             (setf (terminal-ui-path-search-function active-ui)
+                   (lambda (query) (declare (ignore query)) (list "plain")))
+             (terminal-ui-set-input active-ui "@plain")
+             (terminal-ui-process-event active-ui :complete)
+             (terminal-ui-process-event active-ui :submit)
+             (let ((saved (first (terminal-ui-file-contexts active-ui))))
+               (terminal-ui-process-event active-ui '(:insert " @next"))
+               (test-assert (not (terminal-ui-completion-active-p active-ui))
+                            "the second query offers candidates without previewing")
+               (terminal-ui-process-event active-ui :escape)
+               (test-assert
+                (and (string= (line-editor-text (terminal-ui-editor active-ui))
+                              "plain @next")
+                     (eq saved (first (terminal-ui-file-contexts active-ui))))
+                "dismissing passive candidates preserves the existing snapshot")
+               (terminal-ui-process-event active-ui :complete)
+               (terminal-ui-process-event active-ui :escape)
+               (test-assert
+                (and (string= (line-editor-text (terminal-ui-editor active-ui))
+                              "plain @next")
+                     (eq saved (first (terminal-ui-file-contexts active-ui))))
+                "cancelling an active preview restores the existing snapshot"))
+             ;; Use every native delimiter, including apostrophe and page.
+             (dolist (boundary '(#\Space #\Tab #\Newline #\Return #\Page
+                                 #\" #\' #\( #\)))
+               (test-assert
+                (terminal-ui--file-token-present-p
+                 (format nil "~Cplain~C" boundary boundary) "plain")
+                "snapshot pruning shares the native path boundary rule"))
+             (terminal-ui-set-input active-ui "read '@plain'")
+             (line-editor-set-text (terminal-ui-editor active-ui)
+                                   "read '@plain'" :cursor 11)
+             (terminal-ui-process-event active-ui :complete)
+             (terminal-ui-process-event active-ui :submit)
+             (multiple-value-bind (action payload)
+                 (terminal-ui-process-event active-ui :submit)
+               (test-assert
+                (and (eq action :submit)
+                     (string= (user-message-input-text payload) "read 'plain'")
+                     (= (length (user-message-input-file-contexts payload)) 1))
+                "a snapshot selected inside apostrophes survives submission"))
+             (terminal-ui-process-event active-ui :history-previous)
+             (test-assert (= (length (terminal-ui-file-contexts active-ui)) 1)
+                          "apostrophe-delimited snapshots survive history recall")
+             (terminal-ui-load-history active-ui '("plain @query"))
+             (let ((saved (workspace-file-context-snapshot root "plain")))
+               (terminal-ui-set-input
+                active-ui
+                (user-message-input-create :text "plain" :file-contexts (list saved)))
+               (terminal-ui-process-event active-ui :history-previous)
+               (terminal-ui-process-event active-ui :complete)
+               (terminal-ui-process-event active-ui :escape)
+               (terminal-ui-process-event active-ui :history-next)
+               (test-assert
+                (and (string= (line-editor-text (terminal-ui-editor active-ui)) "plain")
+                     (eq saved (first (terminal-ui-file-contexts active-ui))))
+                "history completion cancellation preserves the saved draft attachments"))
+             (setf (terminal-ui-path-search-function active-ui) nil)
+             (terminal-ui-set-input active-ui "@direct")
+             (terminal-ui-process-event active-ui :complete)
+             (test-assert
+              (and (string= (line-editor-text (terminal-ui-editor active-ui))
+                            "directory/")
+                   (null (terminal-ui-file-contexts active-ui)))
+              "directories retain native insert-only behavior")
+             (terminal-ui-process-event active-ui :escape)
+             (terminal-ui-set-input active-ui "@plain")
+             (let ((*workspace-file-context-maximum-file-bytes* 1))
+               (terminal-ui-process-event active-ui :complete)
+               (test-assert
+                (and (string= (line-editor-text (terminal-ui-editor active-ui))
+                              "@plain")
+                     (null (terminal-ui-file-contexts active-ui))
+                     (terminal-ui-notice active-ui))
+                "failed bounded selection leaves the draft and attachments intact"))
+             (terminal-ui-process-event active-ui :escape)
+             (terminal-ui-set-input active-ui "plain typed text")
+             (multiple-value-bind (action payload)
+                 (terminal-ui-process-event active-ui :submit)
+               (test-assert (and (eq action :submit) (stringp payload))
+                            "typing a path does not create a snapshot"))))
+      (uiop:delete-directory-tree root :validate t :if-does-not-exist :ignore)))
+  nil)
