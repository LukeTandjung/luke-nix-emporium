+(defun test-native-path-response ()
+  "Exact strings use the native request mode; malformed data cannot execute."
+  (let ((names '("space name" "bracket [git:clean]" "quote\"name" "back\\slash")))
+    (test-assert
+     (equal names (application-path--file-result-paths (write-to-string names)))
+     "structured native response preserves special filename characters")
+    (dolist (bad '("(1)" "(\"valid\") trailing" "#.(error \"reader evaluation\")"))
+      (test-assert
+       (handler-case (progn (application-path--file-result-paths bad) nil)
+         (error () t))
+       "invalid native response is rejected")))
+  nil)
+
+(defun test-native-path-worker ()
+  "Exercise native completion and default tool output through the real worker."
+  (let* ((configuration (test-configuration))
+         (root (test-configuration-root configuration))
+         (configuration (configuration-copy configuration :working-directory root))
+         (registry (make-default-tool-registry))
+         (application (make-instance 'application :configuration configuration
+                                    :tool-registry registry :ui nil))
+         (names '("needle" "needle [git:clean].txt" "needle space"
+                  "needle\"quote" "needle\\slash")))
+    (unwind-protect
+         (progn
+           (dolist (name names)
+             (test-terminal-path-completion-write
+              (merge-pathnames (uiop:parse-native-namestring name) root) name))
+           (let ((paths (application-path-search-files application "needle")))
+             (test-assert (equal (sort (copy-list names) #'string<)
+                                 (sort (copy-list paths) #'string<))
+                          "the native provider returns exact paths from its existing worker")
+             (dolist (path paths)
+               (test-assert
+                (string= (workspace-file-context-content
+                          (workspace-file-context-snapshot root path)) path)
+                "the selected exact path cannot resolve to a truncated collision")))
+           (let* ((tool (tool-registry-find registry "search" "files"))
+                  (text (search-worker-request
+                         (search-tool-engine tool) configuration
+                         :operation :files
+                         :arguments '("needle" :glob-p nil :page 0 :page-size 20))))
+             (test-assert (and (stringp text) (search "bytes]" text))
+                          "default :files output remains formatted text")))
+      (tool-registry-close-runtime-state registry)
+      (uiop:delete-directory-tree root :validate t :if-does-not-exist :ignore)))
+  nil)
