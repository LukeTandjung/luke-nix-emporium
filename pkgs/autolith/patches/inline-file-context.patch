+          (terminal-ui--clear-file-completion ui)
+          (setf (terminal-ui-notice ui) (princ-to-string condition)
+                (terminal-ui-notice-deadline ui)
+                (+ (funcall (terminal-ui-clock-function ui)) 4))
+          nil)))))
